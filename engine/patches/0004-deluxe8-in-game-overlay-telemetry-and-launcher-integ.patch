From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Deluxe8 <build@deluxe8.invalid>
Date: Sat, 14 Nov 2026 21:30:55 +0100
Subject: [PATCH] deluxe8: in-game overlay, telemetry and launcher integration

- src/deluxe8 (linked from the Deluxe8 repository): ImGui overlay drawn on the swapchain
  image by the Vulkan presenter, opened with L3+R3 (or F1); while open the emulated
  controllers report a neutral state.
- eden-cli: DELUXE8_* environment handshake (content dirs, telemetry), perf counters
  published twice per second, overlay actions (exit, pause).
- ENABLE_LSFG is available on desktop too (the user supplies Lossless.dll).
---
 CMakeLists.txt                                |  3 +-
 src/CMakeLists.txt                            |  6 +++
 src/hid_core/CMakeLists.txt                   |  3 ++
 src/hid_core/frontend/emulated_controller.cpp | 18 +++++---
 src/video_core/CMakeLists.txt                 |  4 ++
 .../renderer_vulkan/vk_present_manager.cpp    | 30 +++++++++++++-
 src/yuzu_cmd/CMakeLists.txt                   |  4 ++
 src/yuzu_cmd/yuzu.cpp                         | 41 +++++++++++++++++++
 8 files changed, 101 insertions(+), 8 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5cd51e0..5edeebe 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -90,7 +90,8 @@ option(ENABLE_DEBUG_TOOLS "Enable debugging tools (maxwell disassembler, SPIRV t
 option(ENABLE_WERROR "Enable -Werror diagnostics" ON)
 
 # Lossless Scaling frame generation. Only Android.
-cmake_dependent_option(ENABLE_LSFG "Enable Lossless Scaling frame generation" ON "ANDROID" OFF)
+# Deluxe8: also offered on desktop (the user supplies their own Lossless.dll).
+option(ENABLE_LSFG "Enable Lossless Scaling frame generation" ON)
 
 option(ENABLE_RESHADE "Enable ReShade FX post-processing effects" ON)
 
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 361adb0..8f3824f 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -309,6 +309,12 @@ endif()
 add_subdirectory(common)
 add_subdirectory(network)
 
+# Deluxe8: launcher integration + in-game overlay (see src/deluxe8)
+option(DELUXE8 "Build the Deluxe8 integration (overlay, launcher handshake)" OFF)
+if (DELUXE8)
+    add_subdirectory(deluxe8)
+endif()
+
 if (YUZU_ROOM)
     add_subdirectory(dedicated_room)
 endif()
diff --git a/src/hid_core/CMakeLists.txt b/src/hid_core/CMakeLists.txt
