diff --git a/src/video_core/renderer_vulkan/vk_present_manager.cpp b/src/video_core/renderer_vulkan/vk_present_manager.cpp
index 9298764..ca1d511 100644
--- a/src/video_core/renderer_vulkan/vk_present_manager.cpp
+++ b/src/video_core/renderer_vulkan/vk_present_manager.cpp
@@ -11,6 +11,9 @@
 #include "video_core/renderer_vulkan/present/lsfg_common.h"
 #endif
 #include "video_core/renderer_vulkan/vk_present_manager.h"
+#ifdef DELUXE8
+#include "deluxe8/overlay.h"
+#endif
 #include "video_core/renderer_vulkan/vk_scheduler.h"
 #include "video_core/renderer_vulkan/vk_swapchain.h"
 #include "video_core/vulkan_common/vulkan_device.h"
@@ -167,7 +170,16 @@ PresentManager::PresentManager(const vk::Instance& instance_,
     }
 }
 
-PresentManager::~PresentManager() = default;
+PresentManager::~PresentManager() {
+#ifdef DELUXE8
+    if (present_thread.joinable()) {
+        present_thread.request_stop();
+        frame_cv.notify_all();
+        present_thread.join();
+    }
+    Deluxe8::Overlay::ShutdownVulkan();
+#endif
+}
 
 Frame* PresentManager::GetRenderFrame() {
 
@@ -539,6 +551,22 @@ void PresentManager::CopyToSwapchainImpl(Frame* frame) {
                          MakeImageCopy(frame->width, frame->height, extent.width, extent.height));
     }
 
+#ifdef DELUXE8
+    Deluxe8::Overlay::RecordVulkan({
+        .instance = *instance,
+        .get_instance_proc_addr = device.GetDispatchLoader().vkGetInstanceProcAddr,
+        .physical_device = device.GetPhysical(),
+        .device = *device.GetLogical(),
+        .queue_family = device.GetGraphicsFamily(),
+        .queue_mutex = &scheduler.submit_mutex,
+        .cmdbuf = *cmdbuf,
+        .image = image,
+        .format = swapchain.GetImageViewFormat(),
+        .extent = extent,
+        .image_count = static_cast<uint32_t>(swapchain.GetImageCount()),
+    });
+#endif
+
     cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_GRAPHICS_BIT, {},
                            {}, {}, post_barriers);
 
