 if(UNIX AND NOT APPLE)
diff --git a/src/yuzu_cmd/yuzu.cpp b/src/yuzu_cmd/yuzu.cpp
index 8067151..c4d96ec 100644
--- a/src/yuzu_cmd/yuzu.cpp
+++ b/src/yuzu_cmd/yuzu.cpp
@@ -36,6 +36,12 @@
 #include "input_common/main.h"
 #include "network/network.h"
 #include "sdl_config.h"
+#ifdef DELUXE8
+#include <chrono>
+#include <format>
+#include "deluxe8/deluxe8.h"
+#include "deluxe8/overlay.h"
+#endif
 #include "video_core/gpu.h"
 #include "video_core/rasterizer_interface.h"
 #include "video_core/renderer_base.h"
@@ -194,6 +200,9 @@ extern "C" SDL_AppResult SDL_AppInit(void **appstate, int argc, char **argv) {
     LocalFree(argv_w);
 #endif
     SdlConfig config{lp.config_path};
+#ifdef DELUXE8
+    Deluxe8::Initialize();
+#endif
 
     Core::ApplyLaunchParams(lp);
 
@@ -320,6 +329,24 @@ extern "C" SDL_AppResult SDL_AppInit(void **appstate, int argc, char **argv) {
         state->system.Run();
     });
 
+#ifdef DELUXE8
+    Deluxe8::SetActions({
+        .request_exit = [] {
+            SDL_Event quit{};
+            quit.type = SDL_EVENT_QUIT;
+            SDL_PushEvent(&quit);
+        },
+        .set_paused = [state](bool paused) {
+            if (paused) {
+                state->system.Pause();
+            } else {
+                void(state->system.Run());
+            }
+        },
+    });
+    Deluxe8::Emit(std::format(R"({{"t":"running","program_id":"{:016X}"}})",
+                              state->system.GetApplicationProcessProgramID()));
+#endif
     void(state->system.Run());
     if (state->system.DebuggerEnabled())
         state->system.InitializeDebugger();
@@ -327,10 +354,24 @@ extern "C" SDL_AppResult SDL_AppInit(void **appstate, int argc, char **argv) {
 }
 extern "C" SDL_AppResult SDL_AppIterate(void *appstate) {
     SdlState *state = (SdlState *)appstate;
+#ifdef DELUXE8
+    static auto next_perf = std::chrono::steady_clock::now();
+    if (const auto now = std::chrono::steady_clock::now(); now >= next_perf && state->system.IsPoweredOn()) {
+        next_perf = now + std::chrono::milliseconds(500);
+        const auto perf = state->system.GetAndResetPerfStats();
+        Deluxe8::PublishPerf({perf.average_game_fps, perf.frametime * 1000.0,
+                              perf.emulation_speed * 100.0});
+    }
+#endif
     return state->emu_window->IsOpen() ? SDL_APP_CONTINUE : SDL_APP_SUCCESS;
 }
 extern "C" SDL_AppResult SDL_AppEvent(void *appstate, SDL_Event *event) {
     SdlState *state = (SdlState *)appstate;
+#ifdef DELUXE8
+    if (Deluxe8::Overlay::HandleSdlEvent(*event)) {
+        return SDL_APP_CONTINUE;
+    }
+#endif
     state->emu_window->OnEvent(*event);
     return SDL_APP_CONTINUE;
 }
