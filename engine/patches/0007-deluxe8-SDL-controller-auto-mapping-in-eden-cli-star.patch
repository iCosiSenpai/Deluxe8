From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Deluxe8 <build@deluxe8.invalid>
Date: Sat, 14 Nov 2026 21:56:33 +0100
Subject: [PATCH] deluxe8: SDL controller auto-mapping in eden-cli (startup +
 hot-plug)

---
 src/yuzu_cmd/CMakeLists.txt | 2 +-
 src/yuzu_cmd/yuzu.cpp       | 7 +++++++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/yuzu_cmd/CMakeLists.txt b/src/yuzu_cmd/CMakeLists.txt
index b7e0c53..5463ad0 100644
--- a/src/yuzu_cmd/CMakeLists.txt
+++ b/src/yuzu_cmd/CMakeLists.txt
@@ -49,7 +49,7 @@ target_include_directories(yuzu-cmd PRIVATE ${RESOURCES_DIR})
 
 target_link_libraries(yuzu-cmd PRIVATE SDL3::SDL3)
 if (DELUXE8)
-    target_link_libraries(yuzu-cmd PRIVATE deluxe8)
+    target_link_libraries(yuzu-cmd PRIVATE deluxe8_frontend)
     target_compile_definitions(yuzu-cmd PRIVATE DELUXE8)
 endif()
 target_link_libraries(yuzu-cmd PRIVATE OpenSSL::SSL OpenSSL::Crypto)
diff --git a/src/yuzu_cmd/yuzu.cpp b/src/yuzu_cmd/yuzu.cpp
index 06bd906..d8956bb 100644
--- a/src/yuzu_cmd/yuzu.cpp
+++ b/src/yuzu_cmd/yuzu.cpp
@@ -41,6 +41,7 @@
 #include <format>
 #include "deluxe8/deluxe8.h"
 #include "deluxe8/overlay.h"
+#include "deluxe8/automap.h"
 #include "core/perf_stats.h"
 #endif
 #include "video_core/gpu.h"
@@ -331,6 +332,7 @@ extern "C" SDL_AppResult SDL_AppInit(void **appstate, int argc, char **argv) {
     });
 
 #ifdef DELUXE8
+    Deluxe8::Input::AutoMap(state->input_subsystem, state->system.HIDCore(), Deluxe8::Players());
     Deluxe8::SetActions({
         .request_exit = [] {
             SDL_Event quit{};
@@ -359,6 +361,11 @@ extern "C" SDL_AppResult SDL_AppIterate(void *appstate) {
     static auto next_perf = std::chrono::steady_clock::now();
     if (const auto now = std::chrono::steady_clock::now(); now >= next_perf && state->system.IsPoweredOn()) {
         next_perf = now + std::chrono::milliseconds(500);
+        // Controllers can enumerate late or be plugged in mid-race.
+        static int automap_tick = 0;
+        if (++automap_tick % 2 == 0) {
+            Deluxe8::Input::AutoMap(state->input_subsystem, state->system.HIDCore(), Deluxe8::Players());
+        }
         const auto perf = state->system.GetAndResetPerfStats();
         Deluxe8::PublishPerf({perf.average_game_fps, perf.frametime * 1000.0,
                               perf.emulation_speed * 100.0});
