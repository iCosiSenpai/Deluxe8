{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: window controls, file pickers and the licence pages of downloaded components (folders are opened by the backend, see open_folder).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/NVIDIA/DLSS/*" },
        { "url": "https://github.com/galarianpikachu2021-hue/Racing-8-DX-Recomp*" }
      ]
    }
  ]
}
